{
    "schema": "http://jhnnsrs-lab/kraph/schema",
    "documents": "graphql/*/**.graphql",
    "extensions": {
        "turms": {
            "domain": null,
            "out_dir": "kraph/api",
            "dump_configuration": true,
            "configuration_name": "project.json",
            "dump_schema": true,
            "schema_name": "schema.graphql",
            "generated_name": "schema.py",
            "documents": "graphql/*/**.graphql",
            "verbose": false,
            "exit_on_error": true,
            "allow_introspection": true,
            "object_bases": [
                "pydantic.BaseModel"
            ],
            "interface_bases": null,
            "always_resolve_interfaces": true,
            "exclude_typenames": true,
            "scalar_definitions": {
                "ID": "rath.scalars.ID",
                "AnyScalar": "typing.Any",
                "JSON": "typing.Any",
                "CypherLiteral": "kraph.scalars.CypherLiteral",
                "StructureIdentifier": "kraph.scalars.StructureIdentifier",
                "StructureObject": "kraph.scalars.StructureObject",
                "UnixMilliseconds": "int",
                "_Any": "typing.Any"
            },
            "coercible_scalars": {},
            "coercible_inputs": {},
            "graphql_default_class": null,
            "deprecated_class": null,
            "document_field_metadata": true,
            "unset_type_class": null,
            "unset_instance": null,
            "freeze": {
                "enabled": true,
                "types": [
                    "input",
                    "fragment",
                    "object"
                ],
                "exclude": null,
                "include": null,
                "convert_list_to_tuple": true
            },
            "create_catchall": true,
            "options": {
                "enabled": true,
                "extra": "forbid",
                "populate_by_name": true,
                "from_attributes": null,
                "use_enum_values": true,
                "validate_assignment": null,
                "alias_mode": "split",
                "types": [
                    "input"
                ],
                "exclude": null,
                "include": null
            },
            "skip_forwards": false,
            "min_python_version": "3.10",
            "type_annotation_style": "auto",
            "external_modules": [],
            "additional_bases": {
                "Graph": [
                    "kraph.traits.GraphTrait"
                ],
                "GraphProjection": [
                    "kraph.traits.ProjectionTrait"
                ],
                "Node": [
                    "kraph.traits.NodeTrait"
                ],
                "Category": [
                    "kraph.traits.CategoryTrait"
                ],
                "EntityCategory": [
                    "kraph.traits.EntityCategoryTrait"
                ],
                "RelationCategory": [
                    "kraph.traits.RelationCategoryTrait"
                ],
                "MeasurementCategory": [
                    "kraph.traits.MeasurementCategoryTrait"
                ],
                "StructureRelationCategory": [
                    "kraph.traits.StructureRelationCategoryTrait"
                ],
                "NaturalEventCategory": [
                    "kraph.traits.NaturalEventCategoryTrait"
                ],
                "ProtocolEventCategory": [
                    "kraph.traits.ProtocolEventCategoryTrait"
                ],
                "Entity": [
                    "kraph.traits.EntityTrait"
                ],
                "Instance": [
                    "kraph.traits.InstanceTrait"
                ],
                "Link": [
                    "kraph.traits.LinkTrait"
                ],
                "Structure": [
                    "kraph.traits.StructureTrait"
                ],
                "Metric": [
                    "kraph.traits.MetricTrait"
                ],
                "Term": [
                    "kraph.traits.TermTrait"
                ],
                "StructureKind": [
                    "kraph.traits.StructureKindTrait"
                ],
                "MetricKind": [
                    "kraph.traits.MetricKindTrait"
                ],
                "Assertion": [
                    "kraph.traits.AssertionTrait"
                ],
                "Standing": [
                    "kraph.traits.StandingTrait"
                ],
                "MediaStore": [
                    "kraph.traits.HasPresignedDownloadAccessor"
                ],
                "AssertedEntity": [
                    "kraph.traits.AssertedTrait",
                    "kraph.traits.HasDrawings"
                ],
                "AssertedNaturalEvent": [
                    "kraph.traits.AssertedTrait",
                    "kraph.traits.HasDrawings"
                ],
                "AssertedProtocolEvent": [
                    "kraph.traits.AssertedTrait",
                    "kraph.traits.HasDrawings"
                ],
                "AssertedInstances": [
                    "kraph.traits.AssertedTrait",
                    "kraph.traits.HasDrawings"
                ],
                "AssertedRelation": [
                    "kraph.traits.AssertedTrait",
                    "kraph.traits.HasDrawings"
                ],
                "AssertedParticipation": [
                    "kraph.traits.AssertedTrait",
                    "kraph.traits.HasDrawings"
                ],
                "AssertedLinks": [
                    "kraph.traits.AssertedTrait",
                    "kraph.traits.HasDrawings"
                ],
                "AssertedStructure": [
                    "kraph.traits.AssertedTrait"
                ],
                "AssertedMetric": [
                    "kraph.traits.AssertedTrait"
                ],
                "AssertedComment": [
                    "kraph.traits.AssertedTrait"
                ],
                "AssertedMeasurement": [
                    "kraph.traits.AssertedTrait"
                ],
                "AssertedDescription": [
                    "kraph.traits.AssertedTrait"
                ],
                "AssertedStructureRelation": [
                    "kraph.traits.AssertedTrait"
                ],
                "AssertedSameness": [
                    "kraph.traits.AssertedTrait"
                ]
            },
            "additional_config": {},
            "force_plugin_order": true,
            "omitted_document_rules": [],
            "parsers": [],
            "plugins": [
                {
                    "type": "turms.plugins.enums.EnumsPlugin"
                },
                {
                    "type": "turms.plugins.inputs.InputsPlugin"
                },
                {
                    "type": "turms.plugins.fragments.FragmentsPlugin"
                },
                {
                    "type": "turms.plugins.operations.OperationsPlugin"
                },
                {
                    "type": "turms.plugins.client.ClientPlugin",
                    "client_class": "KraphApi",
                    "global_kwargs": [
                        {
                            "key": "task",
                            "type": "rath.task.TaskLike",
                            "description": "The task this call is made for; the ambient one by default."
                        }
                    ],
                    "reserved_from": [
                        "kraph.kraph.Kraph"
                    ],
                    "coercible_scalars": {
                        "ID": "rath.scalars.IDCoercible",
                        "CypherLiteral": "kraph.scalars.CypherLiteralCoercible",
                        "StructureIdentifier": "kraph.scalars.StructureIdentifierCoercible",
                        "StructureObject": "kraph.scalars.StructureObjectCoercible"
                    },
                    "expand_input_types": [
                        "input"
                    ]
                }
            ],
            "processors": [
                {
                    "type": "turms.processors.black.BlackProcessor"
                }
            ],
            "stylers": [
                {
                    "type": "turms.stylers.default.DefaultStyler"
                },
                {
                    "type": "turms.stylers.appender.AppenderStyler",
                    "append_fragment": ""
                }
            ]
        }
    }
}
